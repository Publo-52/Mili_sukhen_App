# ─── Supabase Configuration ───────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Optional: Supabase Service Role Key for elevated server-side operations
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Cloudinary Configuration (Photo & Video Memory Vault) ───────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Session Security ─────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your_super_strong_session_secret_at_least_64_characters_long

# ─── Admin & User Credentials (Server-side) ──────────────────────────────────
ADMIN_PASSCODE=your_secure_admin_passcode
MILI_PASSWORD=your_secure_mili_password
SUKHEN_PASSWORD=your_secure_sukhen_password

# ─── YouTube Data API v3 ──────────────────────────────────────────────────────
YOUTUBE_API_KEY=your_youtube_api_key_here
